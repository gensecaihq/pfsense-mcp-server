{
  "mcpServers": {
    "pfsense": {
      "command": "python3.11",
      "args": [
        "-m",
        "src.main"
      ],
      "cwd": "/path/to/pfsense-mcp-server",
      "env": {
        "PFSENSE_URL": "https://your-pfsense.local",
        "PFSENSE_VERSION": "CE_2_8_1",
        "AUTH_METHOD": "api_key",
        "PFSENSE_API_KEY": "your-api-key",
        "VERIFY_SSL": "true",
        "ENABLE_HATEOAS": "false",
        "LOG_LEVEL": "INFO"
      }
    }
  }
}
